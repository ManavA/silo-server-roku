# setup.sh creates .env with random secrets; keep it private and back it up.
# POSTGRES_PASSWORD must be URL-safe because it is used in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
SECRET_KEY=replace-with-openssl-rand-base64-48
MEDIA_ROOT=/path/to/media
SILO_IMAGE=ghcr.io/manava/silo-server-roku:v0.1.0-roku.9
PORT=8090
JF_PORT=8096
ABS_PORT=13378
